{
  "manifest_version": 3,
  "name": "JobRadar",
  "version": "1.0",
  "description": "Save job listings to JobRadar with one click",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobRadar — Save this job"
  },
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
         "https://www.linkedin.com/jobs/*",
      "https://*.indeed.com/*",
      "https://de.indeed.com/*",
      "https://www.stepstone.de/*",
      "https://www.xing.com/jobs/*",
      "https://www.monster.de/*",
      "https://*.greenhouse.io/*",
      "https://*.lever.co/*",
      "https://*.workday.com/*",
      "https://www.glassdoor.de/*",
      "https://www.glassdoor.com/*",
      "https://www.absolventa.de/*",
      "https://www.stellenwerk.de/*",
      "https://www.studentjob.de/*",
      "https://www.zenjob.com/*",
      "https://www.workwise.io/*",
      "https://www.jobvalley.com/*",
      "https://www.jobs.de/*",
      "https://www.bundesagentur.de/*",
      "https://wellfound.com/*",
      "https://remoteok.com/*",
      "https://weworkremotely.com/*",
      "https://relocate.me/*",
      "https://europeremotely.com/*",
      "https://*.internvolt.com/*",
      "https://internshala.com/*",
      "https://www.naukri.com/*",
      "https://*/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
