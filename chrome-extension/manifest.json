{
  "manifest_version": 3,
  "name": "JobRadar",
  "version": "1.0",
  "description": "Save job listings to JobRadar with one click",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "JobRadar — Save this job"
  },
  "permissions": [
    "activeTab",
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/jobs/*",
        "https://*.indeed.com/*",
        "https://www.stepstone.de/*",
        "https://www.xing.com/jobs/*",
        "https://www.monster.de/*",
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.workday.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
